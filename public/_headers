# Netlify: cabeceras de caché y seguridad.

# Los JS y CSS de Vite llevan el hash en el nombre: si cambian, cambia el
# nombre. Se pueden guardar un año sin miedo a servir algo viejo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Las imágenes NO llevan hash: si se reemplaza una con el mismo nombre,
# en una semana todos la ven nueva.
/img/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
